# Copy this file to `.env` and fill in real values before deploying.
# Never commit the real `.env` file (it's already in .gitignore).

# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-value

# Must be False in any environment reachable by untrusted users.
DJANGO_DEBUG=True

# Comma-separated list, required when DJANGO_DEBUG=False, e.g.:
# DJANGO_ALLOWED_HOSTS=api.example.com,www.example.com
DJANGO_ALLOWED_HOSTS=
